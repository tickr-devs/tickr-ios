<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The product name people see (menus, About, Dock); the target and module keep their code name. -->
	<key>CFBundleName</key>
	<string>Tickr</string>
	<!-- Languages the String Catalogs translate (app and shared package). Required for the
	     `make-app.sh` build, whose catalogs live in SwiftPM resource bundles, not the main bundle:
	     without it macOS opens the app in English on a Russian system. -->
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>ru</string>
	</array>
	<!-- The bot's alerts stay on screen until dismissed (System Settings can still change it). -->
	<key>NSUserNotificationAlertStyle</key>
	<string>alert</string>
	<!-- Keys Xcode cannot generate from build settings; the rest is generated (GENERATE_INFOPLIST_FILE). -->
	<!-- The bot's API is plain HTTP on 127.0.0.1 only. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
</dict>
</plist>
