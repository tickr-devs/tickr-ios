<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Passkeys of tickr.bot for the native sign-in: tickr.bot's apple-app-site-association lists this app. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>webcredentials:tickr.bot</string>
	</array>
</dict>
</plist>
