      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every own position closes through the normal exit. Positions the bot did not open are not touched."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada posición propia se cierra mediante la salida normal. No se tocan las posiciones que el bot no abrió."
          }
        }
      }
    },
    "bot.flattenAllQuestion" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
