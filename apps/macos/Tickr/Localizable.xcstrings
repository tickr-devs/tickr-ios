    "bot.silentOpen" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open positions: %lld. The bot's status is stale: it may have stopped. Each position stays under its broker stop, a DAY order: nothing closes it at the session's end. Check the bot on this Mac or close the positions in Webull."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Posiciones abiertas: %lld. El estado del bot está desactualizado: puede que se haya detenido. Cada posición sigue bajo su stop del bróker, una orden DAY: nada la cierra al final de la sesión. Revisa el bot en esta Mac o cierra las posiciones en Webull."
          }
        }
      }
    },
    "bot.silentTitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bot Not Responding with Open Positions"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El bot no responde y hay posiciones abiertas"
          }
        }
      }
    },
    "bot.stopBot" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stop bot"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detener bot"
          }
        }
      }
    },
    "bot.stopExplanation" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The bot stops and stays stopped until you run tickr clear-stop on this Mac; the app cannot start it again. Working entry orders are cancelled. Open positions stay open under their broker stop, a DAY order: nothing closes them at the session's end. Close the positions first to be flat."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El bot se detiene y sigue detenido hasta que ejecutes tickr clear-stop en esta Mac; la app no puede volver a iniciarlo. Se cancelan las órdenes de entrada activas. Las posiciones abiertas siguen abiertas bajo su stop del bróker, una orden DAY: nada las cierra al final de la sesión. Cierra primero las posiciones para quedar sin posiciones."
          }
        }
      }
    },
    "bot.stoppedOpen" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open positions: %lld. Each stays under its broker stop, a DAY order: nothing closes it at the session's end. Close them in Webull, or run tickr clear-stop on this Mac and start the bot to trade again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Posiciones abiertas: %lld. Cada una sigue bajo su stop del bróker, una orden DAY: nada la cierra al final de la sesión. Ciérralas en Webull, o ejecuta tickr clear-stop en esta Mac e inicia el bot para volver a operar."
          }
        }
      }
    },
    "bot.stoppedTitle" : {
