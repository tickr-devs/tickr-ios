    "settings.startExplanation" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "launchd starts the bot job as on a scheduled morning: preflight first, then trading if every check passes. An earlier Stop is cleared, so scheduled starts run again."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "launchd запускает задание бота, как утром по расписанию: сначала предстартовая проверка, затем торговля, если все проверки пройдены. Прошлая остановка снимается, и запуски по расписанию снова работают."
          }
        }
      }
    },
