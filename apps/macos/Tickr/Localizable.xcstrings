    "bot.closeAllExplanation" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The bot pauses entries, cancels its working entry orders and closes every position at market, so it does not enter again. Resume entries when you are ready."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El bot pausa las entradas, cancela sus órdenes de entrada pendientes y cierra cada posición a mercado, así que no vuelve a entrar. Reanuda las entradas cuando quieras."
          }
        }
      }
    },
