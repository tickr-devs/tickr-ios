    "settings.startStopFootnote" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Start = launchctl kickstart of the bot job (preflight runs first), never inside the app or the API. Stop is refused while a trade is open or entering: close the position first."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запуск = launchctl kickstart задания бота (сначала предстартовая проверка), никогда внутри приложения или API. Остановка отклоняется, пока сделка открыта или входит: сначала закрой позицию."
          }
        }
      }
    },
