          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Cerrar todas las posiciones?"
          }
        }
      }
    },
    "bot.flattenExplanation" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The bot cancels the stop, reads the held quantity again and sells it through the normal exit."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El bot cancela el stop, vuelve a leer la cantidad en cartera y la vende mediante la salida normal."
          }
        }
      }
    },
    "bot.flattenQuestion" : {
