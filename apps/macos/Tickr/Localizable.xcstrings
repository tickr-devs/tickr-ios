    "bot.emergencyDetail" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "pauses entries · cancels entry orders · sells all"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "пауза входов · отмена ордеров на вход · продажа всего"
          }
        }
      }
    },
    "bot.emergencyExplanation" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Three steps in order: pause new entries, cancel the bot's working entry orders, close every own position. Each broker stop stays until its closing sale is sent. The bot keeps running."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Три шага по порядку: пауза новых входов, отмена рабочих заявок бота на вход, закрытие всех своих позиций. Брокерский стоп каждой позиции остаётся, пока не отправлена её закрывающая продажа. Бот продолжает работать."
          }
        }
      }
    },
    "bot.emergencyQuestion" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Run the emergency stop?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выполнить аварийную остановку?"
          }
        }
      }
    },
