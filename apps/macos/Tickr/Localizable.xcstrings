    "bot.cancelExplanation" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cancels the bot's own working entry orders. Protective stops are never cancelled."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отменяет только собственные рабочие ордера бота на вход. Защитные стопы не отменяются никогда."
