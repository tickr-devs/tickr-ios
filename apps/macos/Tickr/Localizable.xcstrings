        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detener bot"
          }
        }
      }
    },
    "bot.stopExplanation" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The bot stops and stays stopped, also tomorrow, until you press Start bot. Refused while a trade is open or entering: close it first."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El bot se detiene y sigue detenido, también mañana, hasta que pulses Iniciar bot. Se rechaza mientras haya una operación abierta o entrando: ciérrala primero."
          }
        }
      }
    },
    "bot.stoppedOpen" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open positions: %lld. Each stays under its broker stop, a DAY order: nothing closes it at the session's end. Close them in Webull, or run tickr clear-stop on this Mac and start the bot to trade again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Posiciones abiertas: %lld. Cada una sigue bajo su stop del bróker, una orden DAY: nada la cierra al final de la sesión. Ciérralas en Webull, o ejecuta tickr clear-stop en esta Mac e inicia el bot para volver a operar."
          }
        }
      }
    },
