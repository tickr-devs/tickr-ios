    "risk.lossRoomNote" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profits offset losses but never raise the room above the limit. Open reservations, the worst case of entries in flight, count against it. Near the limit the bot sizes trades down to the room left; below the minimum room it stops entering."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las ganancias compensan las pérdidas, pero nunca elevan el margen por encima del límite. Las reservas abiertas, el peor caso de las entradas en curso, cuentan en su contra. Cerca del límite el bot reduce el tamaño de las operaciones al margen restante; por debajo del margen mínimo deja de entrar."
          }
        }
      }
    },
