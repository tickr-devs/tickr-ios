    "bot.emergency" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emergency stop"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parada de emergencia"
          }
        }
      }
    },
    "bot.emergencyDetail" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "pauses entries · cancels entry orders · sells all"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "pausa las entradas · cancela las órdenes de entrada · vende todo"
          }
        }
      }
    },
    "bot.emergencyExplanation" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Three steps in order: pause new entries, cancel the bot's working entry orders, close every own position. Each broker stop stays until its closing sale is sent. The bot keeps running."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tres pasos en orden: pausar nuevas entradas, cancelar las órdenes de entrada activas del bot y cerrar cada posición propia. Cada stop del bróker se queda hasta que se envía su venta de cierre. El bot sigue en marcha."
          }
        }
      }
    },
    "bot.emergencyQuestion" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Run the emergency stop?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Ejecutar la parada de emergencia?"
          }
        }
      }
    },
