    "bot.cancelExplanation" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cancels the bot's own working entry orders. Protective stops are never cancelled."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cancela las órdenes de entrada activas del propio bot. Los stops de protección nunca se cancelan."
          }
