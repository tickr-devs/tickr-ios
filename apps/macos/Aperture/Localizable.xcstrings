    "bot.flattenAllExplanation" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every own position closes through the normal exit. Positions the bot did not open are not touched."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Каждая собственная позиция закрывается через обычный выход. Позиции, открытые не ботом, не затрагиваются."
          }
        }
      }
    },
    "bot.flattenAllQuestion" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flatten all positions?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Закрыть все позиции?"
          }
        }
      }
    },
    "bot.flattenExplanation" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The bot cancels the stop, reads the held quantity again and sells it through the normal exit."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Бот отменяет стоп, заново читает удерживаемое количество и продаёт его через обычный выход."
          }
        }
      }
    },
