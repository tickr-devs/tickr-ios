    "bot.silentOpen" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open positions: %lld. The bot's status is stale: it may have stopped. Each position stays under its broker stop, a DAY order: nothing closes it at the session's end. Check the bot on this Mac or flatten from Webull."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Открытых позиций: %lld. Статус бота устарел: возможно, он остановился. Каждая позиция остаётся под брокерским стопом, а это DAY-ордер: в конце сессии её никто не закроет. Проверьте бота на этом Mac или закройте позиции в Webull."
          }
        }
      }
    },
    "bot.silentTitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bot Not Responding with Open Positions"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Бот не отвечает, позиции открыты"
          }
        }
      }
    },
    "bot.stopBot" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stop Bot"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Остановить бота"
          }
        }
      }
    },
    "bot.stopExplanation" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The bot stops and stays stopped until you run aperture clear-stop on this Mac; the app cannot start it again. Working entry orders are cancelled. Open positions stay open under their broker stop, a DAY order: nothing closes them at the session's end. Flatten first to be flat."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Бот останавливается и остаётся выключенным, пока вы не выполните aperture clear-stop на этом Mac; приложение запустить его не может. Рабочие заявки на вход отменяются. Открытые позиции остаются под брокерским стопом, а это DAY-ордер: в конце сессии их никто не закроет. Чтобы выйти в кэш, сначала закройте позиции."
          }
        }
      }
    },
    "bot.stoppedOpen" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open positions: %lld. Each stays under its broker stop, a DAY order: nothing closes it at the session's end. Flatten from Webull, or run aperture clear-stop on this Mac and start the bot to trade again."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Открытых позиций: %lld. Каждая остаётся под брокерским стопом, а это DAY-ордер: в конце сессии её никто не закроет. Закройте позиции в Webull или выполните aperture clear-stop на этом Mac и запустите бота, чтобы снова торговать."
          }
        }
      }
    },
