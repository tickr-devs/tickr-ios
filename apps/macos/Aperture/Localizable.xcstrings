    "bot.emergency" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emergency Stop"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Аварийная остановка"
          }
        }
      }
    },
    "bot.emergencyExplanation" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Three steps in order: pause new entries, cancel the bot's working entry orders, flatten every own position. Each broker stop stays until its closing sale is sent. The bot keeps running."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Три шага по порядку: пауза новых входов, отмена рабочих заявок бота на вход, закрытие всех своих позиций. Брокерский стоп каждой позиции остаётся, пока не отправлена её закрывающая продажа. Бот продолжает работать."
          }
        }
      }
    },
    "bot.emergencyQuestion" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Run the emergency stop?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выполнить аварийную остановку?"
          }
        }
      }
    },
