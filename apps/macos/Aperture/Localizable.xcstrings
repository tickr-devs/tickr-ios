    "risk.lossRoomNote" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profits offset losses but never raise the room above the limit. Open reservations, the worst case of entries in flight, count against it. Near the limit the bot sizes trades down to the room left; below the minimum room it stops entering."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Прибыль компенсирует убытки, но не поднимает запас выше лимита. Открытые резервы (худший случай для входов в процессе) тоже вычитаются. У лимита бот уменьшает размер сделки до оставшегося запаса, а ниже минимального запаса перестаёт входить."
          }
        }
