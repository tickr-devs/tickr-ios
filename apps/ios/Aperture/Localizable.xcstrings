    "control.emergencyWarning" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The bot pauses entries, cancels its entry orders and sells every position it holds at market through the normal exit. Each stop is cancelled only right before its sale. Entries stay paused until you resume them."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Бот ставит паузу на входы, отменяет свои ордера на вход и продаёт по рынку все свои позиции через обычный выход. Каждый стоп отменяется только перед своей продажей. Входы остаются на паузе, пока вы их не возобновите."
          }
        }
      }
    },
