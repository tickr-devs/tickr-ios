    "control.stopWarning" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The bot ends gracefully: entry orders are cancelled and broker stops stay. Open positions stay open under DAY stops, and nothing closes them at the session's end. The phone cannot start the bot again: start it on the Mac."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Бот мягко завершает работу: ордера на вход отменяются, стопы у брокера остаются. Открытые позиции остаются открытыми под дневными стопами, и в конце сессии их никто не закроет. С телефона бота снова не запустить: запускайте его на Mac."
          }
        }
      }
    },
