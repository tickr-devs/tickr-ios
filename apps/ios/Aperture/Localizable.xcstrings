    "settings.addressFooter": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In the Simulator the Mac's own address works. On the phone, pair with the link that `python -m aperture.api pair` leaves on the Mac; it reaches the Mac through Tailscale over HTTPS. The token stays in this phone's Keychain and goes only to the paired address."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В симуляторе подходит собственный адрес Mac. На телефоне свяжите его с Mac по ссылке, которую оставляет `python -m aperture.api pair`: телефон обращается к Mac через Tailscale по HTTPS. Токен хранится в Связке ключей телефона и отправляется только на связанный адрес."
          }
        }
      }
    },
