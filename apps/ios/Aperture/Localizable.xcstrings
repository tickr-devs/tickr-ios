    "control.short" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pausing and cancelling never touch broker stops; flattening cancels each stop only right before its sale. Each command is sent once."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пауза и отмена заявок не трогают стопы у брокера; при закрытии позиции стоп снимается только прямо перед продажей. Каждая команда отправляется один раз."
          }
        }
      }
    },
