    "control.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausing and cancelling never touch broker stops. Flatten closes the bot's own positions through the normal exit. Each command is queued once; the bot reports the result."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пауза и отмена никогда не трогают стопы у брокера. Команда «Закрыть все позиции» закрывает только позиции бота через обычный выход. Каждая команда ставится в очередь один раз, результат сообщает бот."
          }
        }
      }
    },
