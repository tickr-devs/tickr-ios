      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Mac starts the bot job through launchd, as on a scheduled morning: preflight first, then trading if every check passes. An earlier Stop is cleared, so scheduled starts run again. Face ID confirms."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La Mac inicia el trabajo del bot mediante launchd, como en una mañana programada: primero la verificación previa y luego el trading si pasan todas las comprobaciones. Se borra un Detener anterior, así que los inicios programados vuelven a ejecutarse. Face ID lo confirma."
          }
        }
      }
    },
