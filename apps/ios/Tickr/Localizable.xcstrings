          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El bot termina de forma ordenada: se cancelan las órdenes de entrada y los stops del bróker se quedan. Las posiciones abiertas siguen abiertas con stops DAY, y nada las cierra al final de la sesión. Vuelve a iniciarlo desde Ajustes."
          }
        }
      }
    },
