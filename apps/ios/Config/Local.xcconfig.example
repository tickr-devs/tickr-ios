// Copy to Local.xcconfig (git-ignored) and fill it in. The signing team is not here: it is in
// apps/Config/Team.xcconfig, shared with the Mac app.

// The file `python -m tickr.api pair-simulator` wrote (its full path, as it prints it): the
// Simulator's own token and the address it opens, read by a Simulator build at launch only.
TICKR_SIMULATOR_TOKEN_FILE = /path/to/data/remote-simulator-token
