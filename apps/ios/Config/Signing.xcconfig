// Build settings that differ per machine or per destination. The bundle id prefix and the signing
// team come from apps/Config/Identity.xcconfig (shared with the Mac app); the Simulator token
// file lives in the git-ignored Config/Local.xcconfig next to this file, never in the committed
// project. To run on your iPhone: copy Local.xcconfig.example to
// Local.xcconfig and fill it in. Do not pick the team in Xcode's Signing & Capabilities, which
// writes it into the project.

#include "../../Config/Identity.xcconfig"

// Every build reads the bot at its address built into the app (TickrKit BotAddress) once the
// owner signs in with his tickr.bot account. A Simulator build may instead read the bot on this
// Mac: the file `python -m tickr.api pair-simulator` wrote (its path in TICKR_SIMULATOR_TOKEN_FILE
// in Local.xcconfig) names the phone's listener on this Mac's loopback and the Simulator's own
// token, so it needs no sign-in (Info.plist, read by Connection.load).
TICKR_SIMULATOR_TOKEN_FILE =
TICKR_SIMULATOR_FILE[sdk=iphonesimulator*] = $(TICKR_SIMULATOR_TOKEN_FILE)

#include? "Local.xcconfig"
