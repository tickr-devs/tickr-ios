// Build settings that differ per machine or per destination. The bundle id prefix and the signing
// team come from apps/Config/Identity.xcconfig (shared with the Mac app); this Mac's Tailscale
// name and the Simulator token file live in the git-ignored Config/Local.xcconfig next to this
// file, never in the committed project. To run on your iPhone: copy Local.xcconfig.example to
// Local.xcconfig and fill it in. Do not pick the team in Xcode's Signing & Capabilities, which
// writes it into the project.

#include "../../Config/Identity.xcconfig"

// Where the app reads the bot's API until a pairing link says otherwise (Info.plist, read by
// Connection.load), per destination:
// - an iPhone build starts at this Mac's Tailscale name (TICKR_TAILSCALE_HOST in Local.xcconfig),
//   which `tailscale serve` forwards to the phone's listener; pairing gives it the token.
// - a Simulator build reads the file `python -m tickr.api pair-simulator` wrote (its path in
//   TICKR_SIMULATOR_TOKEN_FILE in Local.xcconfig): the phone's listener on this Mac's loopback,
//   the same server path as the iPhone, and the Simulator's own token. The file names the
//   address, made from config/bot.toml's [api] remote_port, so the port has one source.
// "/$()/" keeps "//" from starting an xcconfig comment.
TICKR_TAILSCALE_HOST =
TICKR_SIMULATOR_TOKEN_FILE =
TICKR_API_ADDRESS[sdk=iphoneos*] = https:/$()/$(TICKR_TAILSCALE_HOST)
TICKR_SIMULATOR_FILE[sdk=iphonesimulator*] = $(TICKR_SIMULATOR_TOKEN_FILE)

#include? "Local.xcconfig"
