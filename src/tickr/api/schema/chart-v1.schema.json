{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tickr:chart-v1",
  "title": "ChartV1",
  "type": "object",
  "properties": {
    "symbol": {
      "type": "string"
    },
    "interval": {
      "type": "string",
      "enum": [
        "1m",
        "5m",
        "30m",
        "1h",
        "1d",
        "1w",
        "1mo"
      ]
    },
    "range": {
      "type": "string",
      "enum": [
        "1d",
        "5d",
        "1m",
        "3m",
        "1y"
      ]
    },
    "source": {
      "type": "string"
    },
    "cached_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "cause": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "bars": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "start": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
          },
          "open": {
            "type": "string",
            "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
          },
          "high": {
            "type": "string",
            "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
          },
          "low": {
            "type": "string",
            "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
          },
          "close": {
            "type": "string",
            "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
          },
          "volume": {
            "type": "string",
            "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
          },
          "extended": {
            "type": "boolean"
          },
          "session": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "pre",
                  "regular",
                  "after"
                ]
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "start",
          "open",
          "high",
          "low",
          "close",
          "volume",
          "extended"
        ],
        "additionalProperties": false
      }
    },
    "pending": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "read": {
              "type": "integer"
            },
            "total": {
              "type": "integer"
            },
            "retry_after_seconds": {
              "type": "string",
              "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
            }
          },
          "required": [
            "read",
            "total",
            "retry_after_seconds"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "previous_after_candles": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ]
    },
    "api_version": {
      "type": "integer",
      "const": 1
    },
    "cause_codes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "params": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        },
        "required": [
          "code",
          "params"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "symbol",
    "interval",
    "range",
    "source",
    "cached_at",
    "cause",
    "bars",
    "api_version"
  ],
  "additionalProperties": false
}
