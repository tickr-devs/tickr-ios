{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tickr:trade-whatif-v1",
  "title": "TradeWhatIfV1",
  "type": "object",
  "properties": {
    "day": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "symbol": {
      "type": "string"
    },
    "folder": {
      "type": "string"
    },
    "strategy": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "signals": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "filled": {
              "type": "integer"
            },
            "missed": {
              "type": "integer"
            },
            "rejected": {
              "type": "integer"
            },
            "ignored": {
              "type": "integer"
            }
          },
          "required": [
            "filled",
            "missed",
            "rejected",
            "ignored"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "trades": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "signal_at": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
          },
          "opened_at": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
          },
          "entry_price": {
            "type": "string",
            "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
          },
          "stop": {
            "type": "string",
            "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
          },
          "closed_at": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
          },
          "exit_price": {
            "type": "string",
            "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
          },
          "exit_reason": {
            "type": "string",
            "enum": [
              "stop",
              "strategy_exit",
              "flatten",
              "end_of_data"
            ]
          },
          "result_r": {
            "type": "string",
            "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
          },
          "quantity": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
              },
              {
                "type": "null"
              }
            ]
          },
          "result_gross_usd": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "signal_at",
          "opened_at",
          "entry_price",
          "stop",
          "closed_at",
          "exit_price",
          "exit_reason",
          "result_r",
          "quantity",
          "result_gross_usd"
        ],
        "additionalProperties": false
      }
    },
    "result_r": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
        },
        {
          "type": "null"
        }
      ]
    },
    "result_gross_usd": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
        },
        {
          "type": "null"
        }
      ]
    },
    "cause": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "api_version": {
      "type": "integer",
      "const": 1
    },
    "cause_codes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "params": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        },
        "required": [
          "code",
          "params"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "day",
    "symbol",
    "folder",
    "strategy",
    "version",
    "signals",
    "trades",
    "result_r",
    "result_gross_usd",
    "cause",
    "api_version"
  ],
  "additionalProperties": false
}
