{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tickr:symbols-v1",
  "title": "SymbolsV1",
  "type": "object",
  "properties": {
    "day": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "as_of": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
        },
        {
          "type": "null"
        }
      ]
    },
    "as_of_cause": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "stages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "stage": {
            "type": "string",
            "enum": [
              "screeners",
              "universe",
              "quote",
              "bars",
              "strategy",
              "risk",
              "order",
              "stop"
            ]
          },
          "count": {
            "type": "integer"
          }
        },
        "required": [
          "stage",
          "count"
        ],
        "additionalProperties": false
      }
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "symbol": {
            "type": "string"
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "GAINERS",
                    "LOSERS",
                    "TOP_ACTIVES"
                  ]
                },
                "rank": {
                  "type": "integer"
                }
              },
              "required": [
                "kind",
                "rank"
              ],
              "additionalProperties": false
            }
          },
          "change_pct": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
              },
              {
                "type": "null"
              }
            ]
          },
          "first_seen": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
              },
              {
                "type": "null"
              }
            ]
          },
          "furthest": {
            "type": "string",
            "enum": [
              "screeners",
              "universe",
              "quote",
              "bars",
              "strategy",
              "risk",
              "order",
              "stop"
            ]
          },
          "stage": {
            "type": "string",
            "enum": [
              "screeners",
              "universe",
              "quote",
              "bars",
              "strategy",
              "risk",
              "order",
              "stop"
            ]
          },
          "state": {
            "type": "string",
            "enum": [
              "passed",
              "waiting",
              "dropped",
              "not_reached"
            ]
          },
          "cause": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "check": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "rule": {
                    "type": "string"
                  },
                  "measured": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "operator": {
                    "type": "string"
                  },
                  "threshold": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "passed": {
                    "type": "boolean"
                  },
                  "note": {
                    "type": "string"
                  },
                  "against_trigger": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "rule",
                  "measured",
                  "operator",
                  "threshold",
                  "passed",
                  "note"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "verdict": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "IGNORE",
                  "WATCH",
                  "ENTER",
                  "HOLD",
                  "EXIT"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "setup": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "at": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
              },
              {
                "type": "null"
              }
            ]
          },
          "price": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
              },
              {
                "type": "null"
              }
            ]
          },
          "reached": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "stage": {
                  "type": "string",
                  "enum": [
                    "screeners",
                    "universe",
                    "quote",
                    "bars",
                    "strategy",
                    "risk",
                    "order",
                    "stop"
                  ]
                },
                "at": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "stage",
                "at"
              ],
              "additionalProperties": false
            }
          },
          "decided_at": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
              },
              {
                "type": "null"
              }
            ]
          },
          "strategy": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "checks": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "rule": {
                  "type": "string"
                },
                "measured": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "operator": {
                  "type": "string"
                },
                "threshold": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "passed": {
                  "type": "boolean"
                },
                "note": {
                  "type": "string"
                },
                "against_trigger": {
                  "type": "boolean"
                }
              },
              "required": [
                "rule",
                "measured",
                "operator",
                "threshold",
                "passed",
                "note"
              ],
              "additionalProperties": false
            }
          },
          "checked_at": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "symbol",
          "sources",
          "change_pct",
          "first_seen",
          "furthest",
          "stage",
          "state",
          "cause",
          "check",
          "detail",
          "verdict",
          "setup",
          "at"
        ],
        "additionalProperties": false
      }
    },
    "api_version": {
      "type": "integer",
      "const": 1
    }
  },
  "required": [
    "day",
    "as_of",
    "as_of_cause",
    "stages",
    "rows",
    "api_version"
  ],
  "additionalProperties": false
}
