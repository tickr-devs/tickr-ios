{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tickr:settings-history-v1",
  "title": "SettingsHistoryV1",
  "type": "object",
  "properties": {
    "versions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "version": {
            "type": "integer"
          },
          "kind": {
            "type": "string",
            "enum": [
              "apply",
              "rollback",
              "promote"
            ]
          },
          "at": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
          },
          "device": {
            "type": "string",
            "enum": [
              "local",
              "phone",
              "simulator",
              "bot"
            ]
          },
          "biometric_confirmed": {
            "type": "boolean"
          },
          "rollback_to": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "state": {
            "type": "string",
            "enum": [
              "writing",
              "done",
              "not_written",
              "unknown"
            ]
          },
          "files": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "owner": {
                  "type": "string"
                },
                "file": {
                  "type": "string"
                },
                "digest_before": {
                  "type": "string"
                },
                "digest_after": {
                  "type": "string"
                }
              },
              "required": [
                "owner",
                "file",
                "digest_before",
                "digest_after"
              ],
              "additionalProperties": false
            }
          },
          "changes": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "owner": {
                  "type": "string"
                },
                "key": {
                  "type": "string"
                },
                "before": {
                  "type": "string"
                },
                "after": {
                  "type": "string"
                },
                "applies": {
                  "type": "string",
                  "enum": [
                    "at_once",
                    "when_flat",
                    "next_session"
                  ]
                },
                "state": {
                  "type": "string",
                  "enum": [
                    "written",
                    "pending",
                    "promoted",
                    "superseded"
                  ]
                },
                "effective_after": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "settled_by": {
                  "anyOf": [
                    {
                      "type": "integer"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "owner",
                "key",
                "before",
                "after",
                "applies",
                "state",
                "effective_after",
                "settled_by"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "version",
          "kind",
          "at",
          "device",
          "biometric_confirmed",
          "rollback_to",
          "state",
          "files",
          "changes"
        ],
        "additionalProperties": false
      }
    },
    "api_version": {
      "type": "integer",
      "const": 1
    }
  },
  "required": [
    "versions",
    "api_version"
  ],
  "additionalProperties": false
}
