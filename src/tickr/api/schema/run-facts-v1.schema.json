{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tickr:run-facts-v1",
  "title": "RunFactsV1",
  "type": "object",
  "properties": {
    "written_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "run_id": {
      "type": "string"
    },
    "protection_in_force": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "value": {
            "type": "string"
          },
          "adopted_at": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "key",
          "value",
          "adopted_at"
        ],
        "additionalProperties": false
      }
    },
    "realized_loss_week_usd": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
        },
        {
          "type": "null"
        }
      ]
    },
    "stop_out_streak": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ]
    },
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "settings_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "trade_settings_versions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "entry_client_order_id": {
            "type": "string"
          },
          "settings_version": {
            "type": "string"
          }
        },
        "required": [
          "entry_client_order_id",
          "settings_version"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "written_at",
    "run_id",
    "protection_in_force",
    "schema_version"
  ],
  "additionalProperties": false
}
