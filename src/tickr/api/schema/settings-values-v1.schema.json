{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tickr:settings-values-v1",
  "title": "SettingsValuesV1",
  "type": "object",
  "properties": {
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "owner": {
            "type": "string"
          },
          "file": {
            "type": "string"
          },
          "digest": {
            "type": "string"
          }
        },
        "required": [
          "owner",
          "file",
          "digest"
        ],
        "additionalProperties": false
      }
    },
    "values": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "owner": {
            "type": "string"
          },
          "key": {
            "type": "string"
          },
          "value": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "owner",
          "key",
          "value"
        ],
        "additionalProperties": false
      }
    },
    "api_version": {
      "type": "integer",
      "const": 1
    }
  },
  "required": [
    "files",
    "values",
    "api_version"
  ],
  "additionalProperties": false
}
