{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tickr:readiness-v1",
  "title": "ReadinessV1",
  "type": "object",
  "properties": {
    "served_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "environment": {
      "type": "string"
    },
    "config_digest": {
      "type": "string"
    },
    "gate": {
      "type": "object",
      "properties": {
        "open": {
          "type": "boolean"
        },
        "cause": {
          "type": "string"
        },
        "code": {
          "type": "string"
        },
        "params": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "required": [
        "open",
        "cause"
      ],
      "additionalProperties": false
    },
    "environments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "loaded": {
            "type": "boolean"
          },
          "trading_enabled": {
            "type": "boolean"
          },
          "requires_owner_authorization": {
            "type": "boolean"
          },
          "keys_present": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          },
          "gate": {
            "type": "object",
            "properties": {
              "open": {
                "type": "boolean"
              },
              "cause": {
                "type": "string"
              },
              "code": {
                "type": "string"
              },
              "params": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              }
            },
            "required": [
              "open",
              "cause"
            ],
            "additionalProperties": false
          },
          "authorization": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "file": {
                    "type": "string"
                  },
                  "present": {
                    "type": "boolean"
                  },
                  "environment": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "approved_on": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "digest_matches": {
                    "anyOf": [
                      {
                        "type": "boolean"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "valid": {
                    "type": "boolean"
                  },
                  "cause": {
                    "type": "string"
                  },
                  "code": {
                    "type": "string"
                  },
                  "params": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "string"
                    }
                  }
                },
                "required": [
                  "file",
                  "present",
                  "environment",
                  "approved_on",
                  "digest_matches",
                  "valid",
                  "cause",
                  "code",
                  "params"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "name",
          "loaded",
          "trading_enabled",
          "requires_owner_authorization",
          "keys_present",
          "gate",
          "authorization"
        ],
        "additionalProperties": false
      }
    },
    "checklist": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "clean_days",
              "preflight",
              "unattended_safeguard",
              "keys",
              "data_probe",
              "trading_enabled",
              "authorization"
            ]
          },
          "environment": {
            "type": "string"
          },
          "state": {
            "type": "string",
            "enum": [
              "pass",
              "fail",
              "unknown"
            ]
          },
          "value": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "cause": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "code",
          "environment",
          "state",
          "value",
          "cause"
        ],
        "additionalProperties": false
      }
    },
    "api_version": {
      "type": "integer",
      "const": 1
    }
  },
  "required": [
    "served_at",
    "environment",
    "config_digest",
    "gate",
    "environments",
    "checklist",
    "api_version"
  ],
  "additionalProperties": false
}
