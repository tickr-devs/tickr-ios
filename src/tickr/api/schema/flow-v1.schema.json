{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tickr:flow-v1",
  "title": "FlowV1",
  "type": "object",
  "properties": {
    "environment": {
      "type": "string"
    },
    "day": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "chips": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "symbol": {
            "type": "string"
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "GAINERS",
                "LOSERS",
                "TOP_ACTIVES"
              ]
            }
          },
          "change_pct": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
              },
              {
                "type": "null"
              }
            ]
          },
          "change_cause": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "excluded_cause": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "ranks": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "GAINERS",
                    "LOSERS",
                    "TOP_ACTIVES"
                  ]
                },
                "rank": {
                  "type": "integer"
                }
              },
              "required": [
                "kind",
                "rank"
              ],
              "additionalProperties": false
            }
          },
          "price": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
              },
              {
                "type": "null"
              }
            ]
          },
          "change_cause_codes": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "code": {
                  "type": "string"
                },
                "params": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "code",
                "params"
              ],
              "additionalProperties": false
            }
          },
          "excluded_cause_codes": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "code": {
                  "type": "string"
                },
                "params": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "code",
                "params"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "symbol",
          "sources",
          "change_pct",
          "change_cause",
          "excluded_cause"
        ],
        "additionalProperties": false
      }
    },
    "stages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "stage": {
            "type": "string",
            "enum": [
              "screeners",
              "universe",
              "strategy",
              "risk",
              "order",
              "stop"
            ]
          },
          "count": {
            "type": "integer"
          },
          "symbols": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "stage",
          "count",
          "symbols"
        ],
        "additionalProperties": false
      }
    },
    "stops": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "trade_id": {
            "type": "string"
          },
          "symbol": {
            "type": "string"
          },
          "state": {
            "type": "string",
            "enum": [
              "verified",
              "pending",
              "never_verified",
              "unknown"
            ]
          },
          "filled_at": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
              },
              {
                "type": "null"
              }
            ]
          },
          "stop_confirmed_at": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
              },
              {
                "type": "null"
              }
            ]
          },
          "closed_at": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "trade_id",
          "symbol",
          "state",
          "filled_at",
          "stop_confirmed_at",
          "closed_at"
        ],
        "additionalProperties": false
      }
    },
    "reconcile": {
      "type": "object",
      "properties": {
        "agreement": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "match",
                "mismatch"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "agreement_cause": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "read_at": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
            },
            {
              "type": "null"
            }
          ]
        },
        "mismatch": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "fences": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string"
                  },
                  "since": {
                    "type": "string",
                    "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
                  },
                  "text": {
                    "type": "string"
                  },
                  "code": {
                    "type": "string"
                  },
                  "params": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "string"
                    }
                  }
                },
                "required": [
                  "kind",
                  "since",
                  "text"
                ],
                "additionalProperties": false
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "fences_cause": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "agreement_cause_codes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "params": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              }
            },
            "required": [
              "code",
              "params"
            ],
            "additionalProperties": false
          }
        },
        "fences_cause_codes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "params": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              }
            },
            "required": [
              "code",
              "params"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "agreement",
        "agreement_cause",
        "read_at",
        "mismatch",
        "fences",
        "fences_cause"
      ],
      "additionalProperties": false
    },
    "api_version": {
      "type": "integer",
      "const": 1
    }
  },
  "required": [
    "environment",
    "day",
    "chips",
    "stages",
    "stops",
    "reconcile",
    "api_version"
  ],
  "additionalProperties": false
}
