{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tickr:skipped-v1",
  "title": "SkippedV1",
  "type": "object",
  "properties": {
    "day": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "signals": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "at": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
          },
          "symbol": {
            "type": "string"
          },
          "strategy": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "version": {
                "type": "string"
              },
              "settings_version": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "name",
              "version"
            ],
            "additionalProperties": false
          },
          "admission": {
            "type": "string",
            "enum": [
              "taken",
              "refused",
              "not_evaluated",
              "not_applicable"
            ]
          },
          "refusal_cause": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "refusal": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "code": {
                    "type": "string",
                    "enum": [
                      "GATE_CLOSED",
                      "CLOCK_INVALID",
                      "RECONCILIATION_NOT_DONE",
                      "BROKER_READ_MISSING",
                      "BROKER_READ_STALE",
                      "UNRESOLVED_EXPOSURE",
                      "FOREIGN_EXPOSURE",
                      "ENTRY_STOP_SET",
                      "CALENDAR_UNKNOWN",
                      "CALENDAR_DAY_MISMATCH",
                      "HALF_DAY",
                      "OUTSIDE_REGULAR_SESSION",
                      "BEFORE_FIRST_ENTRY",
                      "SESSION_TIMES_INVALID",
                      "AFTER_LAST_ENTRY",
                      "COUNT_INVALID",
                      "OWN_POSITION_OPEN",
                      "OWN_ORDER_WORKING",
                      "POSITION_LIMIT_REACHED",
                      "WORKING_ENTRY_LIMIT_REACHED",
                      "SYMBOL_COOLDOWN",
                      "STOP_OUT_STREAK",
                      "DECISION_NOT_ENTER",
                      "DECISION_NOT_ACTIVE",
                      "STRATEGY_NOT_EXTENDED",
                      "DECISION_INCOMPLETE",
                      "DECISION_INVALID",
                      "ORDER_PRICES_MISSING",
                      "ORDER_PRICES_INVALID",
                      "SETUP_INVALIDATED",
                      "QUOTE_MISSING",
                      "QUOTE_SYMBOL_MISMATCH",
                      "QUOTE_INVALID",
                      "QUOTE_TIME_INVALID",
                      "QUOTE_STALE",
                      "SPREAD_TOO_WIDE",
                      "PRICE_OUTSIDE_WINDOW",
                      "PRICE_COLLAR_UNKNOWN",
                      "PRICE_COLLAR_BREACH",
                      "QUANTITY_BELOW_ONE",
                      "QUANTITY_NOT_WHOLE",
                      "NOTIONAL_OVER_CAP",
                      "PLANNED_LOSS_OVER_LIMIT",
                      "EQUITY_UNKNOWN",
                      "DAILY_MONEY_UNKNOWN",
                      "DAILY_MONEY_INVALID",
                      "DAILY_CEILING",
                      "WEEKLY_MONEY_UNKNOWN",
                      "WEEKLY_MONEY_INVALID",
                      "WEEKLY_CEILING",
                      "BUYING_POWER_UNKNOWN",
                      "BUYING_POWER_SHORT",
                      "ENTRY_BUDGET_UNAVAILABLE",
                      "STOP_BUDGET_UNAVAILABLE",
                      "TRADABILITY_BUDGET_UNAVAILABLE",
                      "TRADABILITY_UNKNOWN",
                      "INSTRUMENT_HALTED",
                      "INSTRUMENT_CLOSE_ONLY",
                      "INSTRUMENT_DENIED",
                      "INSTRUMENT_NOT_TRADABLE",
                      "ENGINE_REFUSED",
                      "UNKNOWN"
                    ]
                  },
                  "message": {
                    "type": "string"
                  },
                  "since": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "until": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "params": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "string"
                    }
                  }
                },
                "required": [
                  "code",
                  "message",
                  "since",
                  "until",
                  "params"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "entry_price": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
              },
              {
                "type": "null"
              }
            ]
          },
          "stop_price": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
              },
              {
                "type": "null"
              }
            ]
          },
          "checks": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "rule": {
                  "type": "string"
                },
                "measured": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "operator": {
                  "type": "string"
                },
                "threshold": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "passed": {
                  "type": "boolean"
                },
                "note": {
                  "type": "string"
                },
                "against_trigger": {
                  "type": "boolean"
                }
              },
              "required": [
                "rule",
                "measured",
                "operator",
                "threshold",
                "passed",
                "note"
              ],
              "additionalProperties": false
            }
          },
          "prices_after": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "minutes": {
                  "type": "integer"
                },
                "at": {
                  "type": "string",
                  "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
                },
                "price": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "change_usd": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "cause": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "cause_codes": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "code": {
                        "type": "string"
                      },
                      "params": {
                        "type": "object",
                        "additionalProperties": {
                          "type": "string"
                        }
                      }
                    },
                    "required": [
                      "code",
                      "params"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "minutes",
                "at",
                "price",
                "change_usd",
                "cause"
              ],
              "additionalProperties": false
            }
          },
          "prices_after_cause": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "what_if": {
            "type": "object",
            "properties": {
              "result_gross_usd": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "result_r": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "exit_reason": {
                "anyOf": [
                  {
                    "type": "string",
                    "enum": [
                      "stop",
                      "strategy_exit",
                      "flatten",
                      "end_of_data"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "cause": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "cause_codes": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string"
                    },
                    "params": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "string"
                      }
                    }
                  },
                  "required": [
                    "code",
                    "params"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "result_gross_usd",
              "result_r",
              "exit_reason",
              "cause"
            ],
            "additionalProperties": false
          },
          "decider": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": [
                      "strategy",
                      "model"
                    ]
                  },
                  "name": {
                    "type": "string"
                  },
                  "version": {
                    "type": "string"
                  }
                },
                "required": [
                  "kind",
                  "name",
                  "version"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "prices_after_cause_codes": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "code": {
                  "type": "string"
                },
                "params": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "code",
                "params"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "at",
          "symbol",
          "strategy",
          "admission",
          "refusal_cause",
          "refusal",
          "entry_price",
          "stop_price",
          "checks",
          "prices_after",
          "prices_after_cause",
          "what_if"
        ],
        "additionalProperties": false
      }
    },
    "api_version": {
      "type": "integer",
      "const": 1
    }
  },
  "required": [
    "day",
    "signals",
    "api_version"
  ],
  "additionalProperties": false
}
