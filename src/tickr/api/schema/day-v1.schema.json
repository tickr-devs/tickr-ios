{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tickr:day-v1",
  "title": "DayV1",
  "type": "object",
  "properties": {
    "environment": {
      "type": "string"
    },
    "day": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "trades": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "trade_id": {
            "type": "string"
          },
          "symbol": {
            "type": "string"
          },
          "quantity": {
            "type": "string",
            "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
          },
          "entry_price": {
            "type": "string",
            "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
          },
          "exit_price": {
            "type": "string",
            "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
          },
          "opened_at": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
          },
          "closed_at": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
          },
          "exit_reason": {
            "type": "string"
          },
          "stop_price": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
              },
              {
                "type": "null"
              }
            ]
          },
          "planned_loss_usd": {
            "type": "string",
            "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
          },
          "result_gross_usd": {
            "type": "string",
            "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
          },
          "stop_confirmed_after_seconds": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
              },
              {
                "type": "null"
              }
            ]
          },
          "mae_usd": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
              },
              {
                "type": "null"
              }
            ]
          },
          "mfe_usd": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
              },
              {
                "type": "null"
              }
            ]
          },
          "entry": {
            "type": "object",
            "properties": {
              "client_order_id": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "intent_at": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "sent_at": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "send_outcome": {
                "anyOf": [
                  {
                    "type": "string",
                    "enum": [
                      "intent",
                      "attempted",
                      "acknowledged",
                      "refused",
                      "unknown",
                      "absent"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "latest_outcome": {
                "anyOf": [
                  {
                    "type": "string",
                    "enum": [
                      "intent",
                      "attempted",
                      "acknowledged",
                      "refused",
                      "unknown",
                      "absent"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "sends": {
                "anyOf": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "filled_at": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "client_order_id",
              "intent_at",
              "sent_at",
              "send_outcome",
              "latest_outcome",
              "sends",
              "filled_at"
            ],
            "additionalProperties": false
          },
          "entry_cause": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "prices_after": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "minutes": {
                  "type": "integer"
                },
                "at": {
                  "type": "string",
                  "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
                },
                "price": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "change_usd": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "cause": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "cause_codes": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "code": {
                        "type": "string"
                      },
                      "params": {
                        "type": "object",
                        "additionalProperties": {
                          "type": "string"
                        }
                      }
                    },
                    "required": [
                      "code",
                      "params"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "minutes",
                "at",
                "price",
                "change_usd",
                "cause"
              ],
              "additionalProperties": false
            }
          },
          "prices_after_cause": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "overshoot_usd": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
              },
              {
                "type": "null"
              }
            ]
          },
          "overshoot_r": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
              },
              {
                "type": "null"
              }
            ]
          },
          "overshoot_cause": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "strategy": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "version": {
                    "type": "string"
                  },
                  "settings_version": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "name",
                  "version"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "code_version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "result_net_usd": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
              },
              {
                "type": "null"
              }
            ]
          },
          "entry_cause_codes": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "code": {
                  "type": "string"
                },
                "params": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "code",
                "params"
              ],
              "additionalProperties": false
            }
          },
          "prices_after_cause_codes": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "code": {
                  "type": "string"
                },
                "params": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "code",
                "params"
              ],
              "additionalProperties": false
            }
          },
          "overshoot_cause_codes": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "code": {
                  "type": "string"
                },
                "params": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "code",
                "params"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "trade_id",
          "symbol",
          "quantity",
          "entry_price",
          "exit_price",
          "opened_at",
          "closed_at",
          "exit_reason",
          "stop_price",
          "planned_loss_usd",
          "result_gross_usd",
          "stop_confirmed_after_seconds",
          "mae_usd",
          "mfe_usd",
          "entry",
          "entry_cause",
          "prices_after",
          "prices_after_cause",
          "overshoot_usd",
          "overshoot_r",
          "overshoot_cause",
          "strategy"
        ],
        "additionalProperties": false
      }
    },
    "result_gross_usd": {
      "type": "string",
      "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
    },
    "bar_symbols": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "result_net_usd": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
        },
        {
          "type": "null"
        }
      ]
    },
    "api_version": {
      "type": "integer",
      "const": 1
    }
  },
  "required": [
    "environment",
    "day",
    "trades",
    "result_gross_usd",
    "bar_symbols",
    "api_version"
  ],
  "additionalProperties": false
}
