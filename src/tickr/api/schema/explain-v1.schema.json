{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tickr:explain-v1",
  "title": "ExplainV1",
  "type": "object",
  "properties": {
    "environment": {
      "type": "string"
    },
    "day": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "symbol": {
      "type": "string"
    },
    "decided_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "bar_start": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "strategy": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "verdict": {
      "type": "string",
      "enum": [
        "IGNORE",
        "WATCH",
        "ENTER",
        "HOLD",
        "EXIT"
      ]
    },
    "setup": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "admission": {
      "type": "string",
      "enum": [
        "taken",
        "refused",
        "not_evaluated",
        "not_applicable"
      ]
    },
    "refusal_cause": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "first_failed_check": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "rule": {
            "type": "string"
          },
          "measured": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
              },
              {
                "type": "null"
              }
            ]
          },
          "operator": {
            "type": "string"
          },
          "threshold": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
              },
              {
                "type": "null"
              }
            ]
          },
          "passed": {
            "type": "boolean"
          },
          "note": {
            "type": "string"
          },
          "against_trigger": {
            "type": "boolean"
          }
        },
        "required": [
          "rule",
          "measured",
          "operator",
          "threshold",
          "passed",
          "note"
        ],
        "additionalProperties": false
      }
    },
    "api_version": {
      "type": "integer",
      "const": 1
    },
    "decider": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "strategy",
                "model"
              ]
            },
            "name": {
              "type": "string"
            },
            "version": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "name",
            "version"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "environment",
    "day",
    "symbol",
    "decided_at",
    "bar_start",
    "strategy",
    "version",
    "verdict",
    "setup",
    "admission",
    "refusal_cause",
    "first_failed_check",
    "checks",
    "api_version"
  ],
  "additionalProperties": false
}
