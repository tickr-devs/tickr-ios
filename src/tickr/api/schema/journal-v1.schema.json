{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tickr:journal-v1",
  "title": "JournalV1",
  "type": "object",
  "properties": {
    "last_seq": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ]
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "seq": {
            "type": "integer"
          },
          "at": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
          },
          "kind": {
            "type": "string"
          },
          "symbol": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "seq",
          "at",
          "kind",
          "symbol"
        ],
        "additionalProperties": false
      }
    },
    "cause": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "api_version": {
      "type": "integer",
      "const": 1
    }
  },
  "required": [
    "last_seq",
    "rows",
    "cause",
    "api_version"
  ],
  "additionalProperties": false
}
