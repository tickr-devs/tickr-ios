{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tickr:days-v1",
  "title": "DaysV1",
  "type": "object",
  "properties": {
    "environment": {
      "type": "string"
    },
    "days": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "day": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "trades": {
            "type": "integer"
          },
          "wins": {
            "type": "integer"
          },
          "losses": {
            "type": "integer"
          },
          "result_gross_usd": {
            "type": "string",
            "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
          },
          "has_bars": {
            "type": "boolean"
          },
          "clean": {
            "type": "object",
            "properties": {
              "verdict": {
                "type": "string",
                "enum": [
                  "clean",
                  "not_clean",
                  "unknown"
                ]
              },
              "cause": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "causes": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "enum": [
                        "reconcile_mismatch",
                        "unknown_order_outcome",
                        "unprotected_position",
                        "safety_exit",
                        "day_end_not_clean"
                      ]
                    },
                    "text": {
                      "type": "string"
                    },
                    "journal_seqs": {
                      "type": "array",
                      "items": {
                        "type": "integer"
                      }
                    },
                    "text_codes": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "code": {
                            "type": "string"
                          },
                          "params": {
                            "type": "object",
                            "additionalProperties": {
                              "type": "string"
                            }
                          }
                        },
                        "required": [
                          "code",
                          "params"
                        ],
                        "additionalProperties": false
                      }
                    }
                  },
                  "required": [
                    "kind",
                    "text",
                    "journal_seqs"
                  ],
                  "additionalProperties": false
                }
              },
              "reconcile_rows": {
                "type": "integer"
              },
              "first_reconcile_at": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "last_reconcile_at": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "day_end_seq": {
                "anyOf": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "cause_codes": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string"
                    },
                    "params": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "string"
                      }
                    }
                  },
                  "required": [
                    "code",
                    "params"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "verdict",
              "cause",
              "causes",
              "reconcile_rows",
              "first_reconcile_at",
              "last_reconcile_at",
              "day_end_seq"
            ],
            "additionalProperties": false
          },
          "result_net_usd": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "day",
          "trades",
          "wins",
          "losses",
          "result_gross_usd",
          "has_bars",
          "clean"
        ],
        "additionalProperties": false
      }
    },
    "api_version": {
      "type": "integer",
      "const": 1
    }
  },
  "required": [
    "environment",
    "days",
    "api_version"
  ],
  "additionalProperties": false
}
